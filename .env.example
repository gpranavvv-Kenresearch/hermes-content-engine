# Copy this file to .env. Never commit the filled .env or credential JSON.
# Optional: load API keys from another private dotenv file.
CE_ENV_FILE=
# Required unless GOOGLE_SERVICE_ACCOUNT_JSON is supplied in the process environment.
CE_GOOGLE_SA_FILE=

# Hermes authentication is configured with hermes model / hermes auth, separately.
HCE_HERMES_BIN=hermes
CE_REWRITE_MAX_ROUNDS=2
CE_DRY_RUN=true
CE_SHADOW_MODE=true
CE_PLATFORMS_ENABLED=
# Required: target spreadsheet ID. No production Sheet ID is stored in Git.
CE_SHEET_ID=
CE_SHEET_TAB=Social Media
CE_OLLAMA_MODEL=
# Only --brain chain uses this configured API/local order.
CE_TEXT_PROVIDERS=ollama,groq,openrouter,nvidia

# Performance Engine: public post URLs are the default and need no platform key.
# Optional: retry counter-less public HTML in a fresh headless browser (no cookies/session).
PE_PUBLIC_BROWSER=1
PE_BROWSER_CHANNEL=chrome
# Optional: after public collection fails, use configured official platform analytics.
PE_NATIVE_FALLBACK=0
# Optional live research. TAVILY_API_KEY_1, _2, etc. are also supported.
TAVILY_API_KEY=

# Imported browser-generation flows.
# Single image accepts these names and also falls back to CE_SHEET_ID / CE_GOOGLE_SA_FILE.
SOCIAL_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=.accounts/google-service-account.json
# Optional alternative to credential files: complete JSON supplied privately.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional Chrome executable override.
CHROME_PATH=
# Optional run reporting; browser generation continues when blank.
AUTOMATION_DASHBOARD_URL=
AUTOMATION_DASHBOARD_TOKEN=
