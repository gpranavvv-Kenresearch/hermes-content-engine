# Browser generation uses the Hermes Content Engine root as its working directory.
# Put private values in the root .env file; never commit them.

# Single-image sheet access.
SOCIAL_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=.accounts/google-service-account.json

# Alternative for every Google Sheets flow: the complete service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Chrome executable override.
CHROME_PATH=

# Optional dashboard reporting. Generation continues when these are blank.
AUTOMATION_DASHBOARD_URL=
AUTOMATION_DASHBOARD_TOKEN=

# Optional Google Drive folder for generated blog images.
GOOGLE_DRIVE_FOLDER_ID=
