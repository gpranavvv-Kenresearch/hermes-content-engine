{
  "name": "hermes-content-engine",
  "version": "0.0.1",
  "private": true,
  "description": "Standalone Ken Research social text engine with Hermes repair memory, source validation and Sheet handoff",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hce:doctor": "tsx src/social/cli.ts doctor",
    "hce:draft": "tsx src/social/cli.ts draft",
    "hce:next": "tsx src/social/cli.ts next",
    "hce:history": "tsx src/social/cli.ts history",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "requirements:check": "tsx scripts/check-requirements.ts",
    "check:config": "tsx src/cli.ts check-config",
    "probe:llm": "tsx src/cli.ts probe-llm",
    "validate": "tsx src/cli.ts validate",
    "audit:legacy": "tsx src/cli.ts audit-legacy",
    "gather:evidence": "tsx src/cli.ts gather-evidence",
    "generate": "tsx src/social/cli.ts draft",
    "next": "tsx src/social/cli.ts next",
    "next:li": "tsx src/social/cli.ts next --platform li",
    "next:fb": "tsx src/social/cli.ts next --platform fb",
    "legacy:generate": "tsx src/cli.ts generate",
    "legacy:next": "tsx src/cli.ts next",
    "next:x": "tsx src/cli.ts next --platform x",
    "repo:intake": "tsx src/cli.ts repo-intake",
    "repo:adopt": "tsx src/cli.ts repo-adopt",
    "repo:list": "tsx src/cli.ts repo-list",
    "repo:mark": "tsx src/cli.ts repo-mark",
    "lab:add": "tsx src/cli.ts lab-add",
    "lab:run": "tsx src/cli.ts lab-run",
    "lab:check": "tsx src/cli.ts lab-check",
    "lab:list": "tsx src/cli.ts lab-list",
    "gen:vale": "tsx scripts/gen-vale-styles.ts",
    "login:chatgpt": "tsx scripts/login-chatgpt.ts",
    "browser:doctor": "tsx browser-generation/src/cli.ts doctor",
    "browser:login": "tsx browser-generation/src/cli.ts login",
    "browser:single": "tsx browser-generation/src/cli.ts single",
    "browser:carousel": "tsx browser-generation/src/cli.ts carousel",
    "browser:blog": "tsx browser-generation/src/cli.ts blog",
    "blog:run": "tsx browser-generation/blog-supervisor/src/cli.ts run",
    "blog:final": "tsx browser-generation/blog-supervisor/src/cli.ts final",
    "blog:sample": "tsx browser-generation/blog-supervisor/src/cli.ts sample",
    "blog:check": "tsx browser-generation/blog-supervisor/src/cli.ts check",
    "blog:status": "tsx browser-generation/blog-supervisor/src/cli.ts status",
    "blog:unpark": "tsx browser-generation/blog-supervisor/src/cli.ts unpark",
    "browser:blog-structures": "tsx browser-generation/src/tools/buildBlogStructures.ts",
    "browser:blog-loop": "tsx browser-generation/src/cli.ts blog-loop",
    "browser:typecheck": "tsc -p browser-generation/tsconfig.json --noEmit",
    "hermes:run": "tsx supervisor-hermes/src/cli.ts run",
    "hermes:status": "tsx supervisor-hermes/src/cli.ts status",
    "hermes:overnight": "tsx supervisor-hermes/src/overnight-cli.ts",
    "hermes:generate-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-cycle.ps1 -SkipFeedback",
    "hermes:full-cycle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-full-cycle.ps1",
    "hermes:schedule-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-full-cycle.ps1",
    "performance:doctor": "tsx performance-engine/src/cli.ts doctor",
    "performance:discover": "tsx performance-engine/src/cli.ts discover",
    "performance:track": "tsx performance-engine/src/cli.ts track",
    "performance:inspect": "tsx performance-engine/src/cli.ts inspect",
    "performance:import": "tsx performance-engine/src/cli.ts import",
    "performance:enrich": "tsx performance-engine/src/cli.ts enrich",
    "performance:learn": "tsx performance-engine/src/cli.ts learn",
    "performance:research": "tsx performance-engine/src/cli.ts research",
    "performance:advise": "tsx performance-engine/src/cli.ts advise",
    "performance:guidance": "tsx performance-engine/src/cli.ts apply-guidance",
    "performance:test-loop": "tsx performance-engine/src/cli.ts test-loop",
    "performance:auto-loop": "tsx performance-engine/src/cli.ts auto-loop",
    "performance:auto-all": "tsx performance-engine/src/all-platform-cli.ts",
    "performance:experiment": "tsx performance-engine/src/cli.ts experiment",
    "performance:report": "tsx performance-engine/src/cli.ts report",
    "performance:sync": "tsx performance-engine/src/cli.ts sync",
    "performance:policy": "tsx performance-engine/src/cli.ts apply-policy",
    "performance:rollback": "tsx performance-engine/src/cli.ts rollback-policy",
    "performance:run": "tsx performance-engine/src/cli.ts run",
    "performance:status": "tsx performance-engine/src/cli.ts status",
    "hermes:continuous": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-continuous-text.ps1",
    "hermes:continuous-status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-continuous-text.ps1 -Status",
    "hermes:blog-continuous": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-continuous-blog.ps1",
    "hermes:blog-continuous-status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-continuous-blog.ps1 -Status",
    "hermes:blog-continuous-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-continuous-blog.ps1",
    "hermes:continuous-install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-continuous-text.ps1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tavily/core": "^0.7.14",
    "cockatiel": "^4.0.0",
    "defuddle": "^0.19.5",
    "dotenv": "^18.0.7",
    "exa-js": "^2.25.0",
    "google-auth-library": "^11.3.0",
    "googleapis": "^144.0.0",
    "cheerio": "^1.2.0",
    "jsdom": "^29.1.1",
    "pino": "^10.4.0",
    "playwright": "^1.64.0",
    "rss-parser": "^3.13.0",
    "satori": "^0.52.0",
    "undici": "^8.11.2",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
